# Copier ce fichier en .env puis adapter si besoin (.env n'est pas versionné).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pipeline
DB_USER=pipeline
DB_PASSWORD=pipeline

# Base utilisée par les tests d'intégration (vidée avant chaque test).
TEST_DB_NAME=pipeline_test

# Stockage S3 (RustFS). Les mêmes identifiants servent à se connecter à la console :
# http://localhost:9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=pipeline
S3_SECRET_KEY=pipeline-secret
S3_BUCKET=transactions
S3_REGION=us-east-1
